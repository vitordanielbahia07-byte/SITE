const getEventIcon = (type: Event['type']) => {
  switch (type) {
    case 'technical': return <Code className="h-4 w-4" />;
    case 'academic': return <BookOpen className="h-4 w-4" />;
    case 'competition': return <Trophy className="h-4 w-4" />;
    case 'cultural': return <Users className="h-4 w-4" />;
    case 'administrative': return <GraduationCap className="h-4 w-4" />;
    default: return <CalendarIcon className="h-4 w-4" />;
  }
};

const getEventColor = (type: Event['type']) => {
  switch (type) {
    case 'technical': return 'bg-blue-500/10 text-blue-700 border-blue-200';
    case 'academic': return 'bg-green-500/10 text-green-700 border-green-200';
    case 'competition': return 'bg-orange-500/10 text-orange-700 border-orange-200';
    case 'cultural': return 'bg-purple-500/10 text-purple-700 border-purple-200';
    case 'administrative': return 'bg-gray-500/10 text-gray-700 border-gray-200';
    default: return 'bg-primary/10 text-primary border-primary/20';
  }
};

export const EventsSection = ({ isOpen, onClose }: EventsSectionProps) => {
  const [selectedDate, setSelectedDate] = useState<Date | undefined>(new Date());
  const [currentMonth, setCurrentMonth] = useState<Date>(new Date());

  if (!isOpen) return null;

  const getEventsForDate = (date: Date): Event[] => {
    return schoolEvents.filter(event => isSameDay(event.date, date));
  };

  const getDaysWithEvents = (): Date[] => {
    return schoolEvents.map(event => event.date);
  };

  const selectedDateEvents = selectedDate ? getEventsForDate(selectedDate) : [];

  return (
    <div className="fixed inset-0 bg-background/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
      <Card className="w-full max-w-4xl max-h-[90vh] overflow-hidden animate-scale-in">
        <CardHeader className="flex flex-row items-center justify-between border-b">
          <div>
            <CardTitle className="text-primary flex items-center gap-2">
              <CalendarIcon className="h-5 w-5" />
              Calendário de Eventos Acadêmicos
            </CardTitle>
            <p className="text-sm text-muted-foreground mt-1">
              Técnico em Informática - CEAAT
            </p>
          </div>
          <Button variant="ghost" size="sm" onClick={onClose}>
            <X className="h-4 w-4" />
          </Button>
        </CardHeader>
        
        <div className="flex">
          {/* Calendar Section */}
          <div className="flex-1 p-6">
            <Calendar
              mode="single"
              selected={selectedDate}
              onSelect={setSelectedDate}
              month={currentMonth}
              onMonthChange={setCurrentMonth}
              className="rounded-md border pointer-events-auto w-full"
              locale={ptBR}
              modifiers={{
                hasEvents: getDaysWithEvents()
              }}
              modifiersStyles={{
                hasEvents: {
                  backgroundColor: 'hsl(var(--primary) / 0.1)',
                  color: 'hsl(var(--primary))',
                  fontWeight: 'bold'
                }
              }}
              numberOfMonths={1}
              showOutsideDays={true}
            />
            
            <div className="mt-4 space-y-2">
              <h4 className="font-semibold text-sm">Legenda:</h4>
              <div className="flex flex-wrap gap-2">
                <Badge variant="outline" className="bg-blue-500/10 text-blue-700 border-blue-200">
                  <Code className="h-3 w-3 mr-1" />
                  Técnico
                </Badge>
                <Badge variant="outline" className="bg-green-500/10 text-green-700 border-green-200">
                  <BookOpen className="h-3 w-3 mr-1" />
                  Acadêmico
                </Badge>
                <Badge variant="outline" className="bg-orange-500/10 text-orange-700 border-orange-200">
                  <Trophy className="h-3 w-3 mr-1" />
                  Competição
                </Badge>
                <Badge variant="outline" className="bg-purple-500/10 text-purple-700 border-purple-200">
                  <Users className="h-3 w-3 mr-1" />
                  Cultural
                </Badge>
              </div>
            </div>
          </div>

          {/* Events Details Section */}
          <div className="w-80 border-l bg-muted/30 p-6 overflow-y-auto max-h-[90vh]">
            {selectedDate ? (
              <div className="space-y-4">
                <div>
                  <h3 className="font-semibold text-lg mb-1">
                    {format(selectedDate, "dd 'de' MMMM", { locale: ptBR })}
                  </h3>
                  <p className="text-sm text-muted-foreground">
                    {format(selectedDate, "EEEE, yyyy", { locale: ptBR })}
                  </p>
                </div>

                <Separator />

                {selectedDateEvents.length > 0 ? (
                  <div className="space-y-3">
                    <h4 className="font-medium text-sm">Eventos do dia ({selectedDateEvents.length})</h4>
                    {selectedDateEvents.map((event) => (
                      <div
                        key={event.id}
                        className="p-3 rounded-lg border bg-background shadow-sm hover:shadow-md transition-shadow"
                      >
                        <div className="flex items-start justify-between mb-2">
                          <h5 className="font-medium text-sm leading-tight">{event.title}</h5>
                          <Badge variant="outline" className={`ml-2 ${getEventColor(event.type)}`}>
                            {getEventIcon(event.type)}
                          </Badge>
                        </div>
                        
                        <p className="text-xs text-muted-foreground mb-2 leading-relaxed">
                          {event.description}
                        </p>
                        
                        <div className="space-y-1">
                          {event.time && (
                            <div className="flex items-center gap-1 text-xs text-muted-foreground">
                              <CalendarIcon className="h-3 w-3" />
                              {event.time}
                            </div>
                          )}
                          {event.location && (
                            <div className="flex items-center gap-1 text-xs text-muted-foreground">
                              <Presentation className="h-3 w-3" />
                              {event.location}
                            </div>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                ) : (
                  <div className="text-center py-8">
                    <CalendarIcon className="h-12 w-12 text-muted-foreground/50 mx-auto mb-3" />
