                      Nenhum evento programado para esta data.
                    </p>
                  </div>
                )}

                <Separator />

                {/* Upcoming Events */}
                <div className="space-y-3">
                  <h4 className="font-medium text-sm">Próximos Eventos</h4>
                  {schoolEvents
                    .filter(event => event.date > new Date())
                    .sort((a, b) => a.date.getTime() - b.date.getTime())
                    .slice(0, 3)
                    .map((event) => (
                      <div
                        key={event.id}
                        className="p-2 rounded border bg-background/50 text-xs"
                      >
                        <div className="flex items-center justify-between mb-1">
                          <span className="font-medium">{event.title}</span>
                          <Badge variant="outline" className={`text-xs ${getEventColor(event.type)}`}>
                            {getEventIcon(event.type)}
                          </Badge>
                        </div>
                        <p className="text-muted-foreground">
                          {format(event.date, "dd/MM/yyyy", { locale: ptBR })}
                          {event.time && ` • ${event.time}`}
                        </p>
                      </div>
                    ))}
                </div>
              </div>
            ) : (
              <div className="text-center py-8">
                <CalendarIcon className="h-12 w-12 text-muted-foreground/50 mx-auto mb-3" />
                <p className="text-sm text-muted-foreground">
                  Selecione uma data no calendário para ver os eventos.
                </p>
              </div>
            )}
          </div>
        </div>
      </Card>
    </div>
  );
};

